{
  "name": "branchboard",
  "version": "0.3.0",
  "description": "A whiteboard for AI chats: run chats side by side on a canvas, branch any answer and connect the answers you want to build on. Free, open source and local, with your claude, codex or opencode command or an API key.",
  "keywords": ["ai", "llm", "chat", "whiteboard", "canvas", "infinite-canvas", "ai-canvas", "branching", "research", "claude", "claude-code", "codex", "opencode", "local-first"],
  "license": "MIT",
  "homepage": "https://github.com/sidorovrv/BranchBoard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sidorovrv/BranchBoard.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/sidorovrv/BranchBoard/issues"
  },
  "type": "module",
  "bin": {
    "branchboard": "bin/branchboard.mjs"
  },
  "files": ["bin", "dist", "README.md", "LICENSE"],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "node scripts/build.mjs"
  },
  "devDependencies": {
    "@branchboard/core": "*",
    "@branchboard/server": "*",
    "esbuild": "^0.28.2"
  }
}
